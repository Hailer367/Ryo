# -----------------------------------------------------------------------------
# RPC (fork tests / deploy)
# -----------------------------------------------------------------------------
BASE_RPC_URL=https://mainnet.base.org
# Optional fork block for the historical replay test. Leave empty for latest.
BASE_FORK_BLOCK=

# -----------------------------------------------------------------------------
# Base mainnet addresses (verified against official docs / on-chain code)
# -----------------------------------------------------------------------------
BALANCER_VAULT=0xBA12222222228d8Ba445958a75a0704d566BF2C8

WETH=0x4200000000000000000000000000000000000006
USDC=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Uniswap V3 SwapRouter02 (Base)
UNISWAP_V3_ROUTER=0x2626664c2603336E57B271c5C0b26F421741e481
# Uniswap V2 Router02 (Base)
UNISWAP_V2_ROUTER=0x4752ba5DBc23f44D87826276BF6Fd6b1C372aD24

# Aerodrome classic router (Base) - dexType 4
AERODROME_ROUTER=0xcF77a3Ba9A5CA399B7c97c74d54e5b1Beb874E43
# Aerodrome Slipstream router (Base) - dexType 7
SLIPSTREAM_ROUTER=0xBE6D8f0d05cC4be24d5167a3eF062215bE6D18a5

# -----------------------------------------------------------------------------
# Deployment
# -----------------------------------------------------------------------------
OWNER=
OPERATOR=

# Primary route 0: borrow WETH, WETH->USDC on V3, USDC->WETH on V2
ROUTE0_ASSET=0x4200000000000000000000000000000000000006
ROUTE0_INTERMEDIATE=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
ROUTE0_BUY_ROUTER=0x2626664c2603336E57B271c5C0b26F421741e481
ROUTE0_BUY_DEX_TYPE=6
ROUTE0_BUY_FEE=500
ROUTE0_SELL_ROUTER=0x4752ba5DBc23f44D87826276BF6Fd6b1C372aD24
ROUTE0_SELL_DEX_TYPE=8
ROUTE0_SELL_FEE=0
# 0 = no per-trade size limit (the bot is the safety net). Set a number to add a hard ceiling.
ROUTE0_MAX_TRADE_SIZE=0

# Primary route 1: borrow USDC, USDC->WETH on V3, WETH->USDC on V2
ROUTE1_ASSET=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
ROUTE1_INTERMEDIATE=0x4200000000000000000000000000000000000006
ROUTE1_BUY_ROUTER=0x2626664c2603336E57B271c5C0b26F421741e481
ROUTE1_BUY_DEX_TYPE=6
ROUTE1_BUY_FEE=500
ROUTE1_SELL_ROUTER=0x4752ba5DBc23f44D87826276BF6Fd6b1C372aD24
ROUTE1_SELL_DEX_TYPE=8
ROUTE1_SELL_FEE=0
# 0 = no per-trade size limit (the bot is the safety net). Set a number to add a hard ceiling.
ROUTE1_MAX_TRADE_SIZE=0

# Comma-separated extra routers to whitelist at deploy (primary routers auto-whitelisted).
# Aerodrome classic + Slipstream routers (dexType 4 and 7) are included by default.
EXTRA_ROUTERS=0xcF77a3Ba9A5CA399B7c97c74d54e5b1Beb874E43,0xBE6D8f0d05cC4be24d5167a3eF062215bE6D18a5

# 0 disables the gas-price check (the bot checks gas itself).
MAX_GAS_PRICE=0

# -----------------------------------------------------------------------------
# Verification (Etherscan V2 key works for BaseScan)
# -----------------------------------------------------------------------------
BASESCAN_API_KEY=
